# No se requieren claves para Ollama local. Nunca poner secretos en el frontend.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192
PORT=3000
MAX_ITERATIONS=25
MAX_SESSION_TOKENS=120000
MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_MS=90000
MAX_SESSIONS=50

# Web / Vercel solamente. Plantilla: NO copiar estos valores como secretos utilizables.
# El modo local anterior conserva Ollama; no usa estas variables.
APP_ORIGIN=https://REEMPLAZAR.vercel.app
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=REEMPLAZAR_EN_BACKEND
UPSTASH_REDIS_REST_URL=https://REEMPLAZAR.upstash.io
UPSTASH_REDIS_REST_TOKEN=REEMPLAZAR_EN_BACKEND
DEMO_ACCESS_CODE=REEMPLAZAR_SECRETO_ALEATORIO_MINIMO_32_CARACTERES
DEMO_COOKIE_SECRET=REEMPLAZAR_OTRO_SECRETO_ALEATORIO_MINIMO_32_CARACTERES
DEMO_NAMESPACE=periferia-demo-preview
DEMO_MODEL_CALLS_DAY=60
DEMO_MODEL_TOKENS_DAY=2000000
# Conservador hasta verificar la cuota efectiva del proyecto. No garantiza lote en un turno.
DEMO_MODEL_RPM=1